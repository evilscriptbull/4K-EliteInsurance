# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Get this from the GA4 property's Admin > Data Streams > web stream.
# Must also be set in your deploy host's environment variables (e.g. Vercel
# project settings) — this file is just a local template, not read in
# production.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# GoTo Connect — internal SMS notifications on new leads/contact messages/claims.
# One-time setup: set GOTO_CLIENT_ID + GOTO_CLIENT_SECRET below, register
# http://localhost:3000/api/integrations/goto/oauth/callback as an allowed
# redirect URI for your OAuth app in GoTo Developer Center (developer.goto.com),
# then (with `npm run dev` running) visit
# http://localhost:3000/api/integrations/goto/oauth/start in your browser,
# log in, and copy the refresh_token it returns into GOTO_REFRESH_TOKEN below.
GOTO_CLIENT_ID=
GOTO_CLIENT_SECRET=
GOTO_REFRESH_TOKEN=
# The GoTo number sending notifications (E.164 format, e.g. +18655551234)
GOTO_OWNER_PHONE_NUMBER=
# The number that should receive internal lead/contact/claim notifications
GOTO_NOTIFY_PHONE_NUMBER=

# EZLynx (Applied Systems) — NOT YET AVAILABLE. EZLynx's API is
# partner/enterprise-gated, not self-serve. See docs/open-questions.md for
# what to request from EZLynx/Applied Systems before these can be set.
# EZLYNX_CLIENT_ID=
# EZLYNX_CLIENT_SECRET=
# EZLYNX_AGENCY_ID=

# Supabase Postgres — durable storage for leads/claims/contact messages.
# Get both from your Supabase project dashboard: Project Settings > Database
# > Connection string.
#
# DATABASE_URL: the "Transaction" pooler connection (port 6543) — used by
# the app at runtime. Required for serverless (Vercel): Postgres has a low
# connection limit and serverless functions open a new connection per
# invocation, so this must go through Supabase's pooler (Supavisor), not a
# direct connection.
DATABASE_URL=

# DIRECT_URL: the direct connection (port 5432) — used only by drizzle-kit
# for migrations (npm run db:generate / db:migrate). Migration tooling
# needs session-level behavior the transaction pooler doesn't support.
DIRECT_URL=

# If unset, the app falls back to in-memory storage automatically (not
# durable, but doesn't break local dev before you've provisioned a DB).
