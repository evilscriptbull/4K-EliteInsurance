# Supabase Postgres — durable storage for leads/claims/contact messages.
# Get both from your Supabase project dashboard: Project Settings > Database
# > Connection string.
#
# DATABASE_URL: the "Transaction" pooler connection (port 6543) — used by
# the app at runtime. Required for serverless (Vercel): Postgres has a low
# connection limit and serverless functions open a new connection per
# invocation, so this must go through Supabase's pooler (Supavisor), not a
# direct connection.
DATABASE_URL=

# DIRECT_URL: the direct connection (port 5432) — used only by drizzle-kit
# for migrations (npm run db:generate / db:migrate). Migration tooling
# needs session-level behavior the transaction pooler doesn't support.
DIRECT_URL=

# If unset, the app falls back to in-memory storage automatically (not
# durable, but doesn't break local dev before you've provisioned a DB).
