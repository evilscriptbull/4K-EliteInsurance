# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX)
# Get this from the GA4 property's Admin > Data Streams > web stream.
# Must also be set in your deploy host's environment variables (e.g. Vercel
# project settings) — this file is just a local template, not read in
# production.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console site ownership verification (HTML tag method).
# From Search Console > Settings > Ownership verification > HTML tag — use
# just the `content` value, not the whole <meta> tag or the
# `google-site-verification=...` DNS TXT record format. Not a secret (it's
# meant to be public in page source), but still lives in env for
# per-environment flexibility, same as the vars above.
GOOGLE_SITE_VERIFICATION=

# GoTo Connect — internal SMS notifications on new leads/contact messages/claims.
# One-time setup:
# 1. At developer.logmeininc.com/clients, edit your OAuth client and enable
#    "Personal Access Token", then copy its Client ID/Client Secret below.
# 2. At myaccount.goto.com > Developer Tools, create a token with the
#    `messaging.v1.send` scope enabled and copy it into
#    GOTO_PERSONAL_ACCESS_TOKEN below. Unlike a refresh token, this doesn't
#    expire or rotate.
GOTO_CLIENT_ID=
GOTO_CLIENT_SECRET=
GOTO_PERSONAL_ACCESS_TOKEN=
# The GoTo number sending notifications (E.164 format, e.g. +18655551234)
GOTO_OWNER_PHONE_NUMBER=
# The number that should receive internal lead/contact/claim notifications
GOTO_NOTIFY_PHONE_NUMBER=

# EZLynx (Applied Systems) — NOT YET AVAILABLE. EZLynx's API is
# partner/enterprise-gated, not self-serve. See docs/open-questions.md for
# what to request from EZLynx/Applied Systems before these can be set.
# EZLYNX_CLIENT_ID=
# EZLYNX_CLIENT_SECRET=
# EZLYNX_AGENCY_ID=

# Supabase Postgres — durable storage for leads/claims/contact messages.
# Get both from your Supabase project dashboard: Project Settings > Database
# > Connection string.
#
# DATABASE_URL: the "Transaction" pooler connection (port 6543) — used by
# the app at runtime. Required for serverless (Vercel): Postgres has a low
# connection limit and serverless functions open a new connection per
# invocation, so this must go through Supabase's pooler (Supavisor), not a
# direct connection.
DATABASE_URL=

# DIRECT_URL: the direct connection (port 5432) — used only by drizzle-kit
# for migrations (npm run db:generate / db:migrate). Migration tooling
# needs session-level behavior the transaction pooler doesn't support.
DIRECT_URL=

# If unset, the app falls back to in-memory storage automatically (not
# durable, but doesn't break local dev before you've provisioned a DB).

# Sanity CMS — blog content (/blog). Get all three from sanity.io/manage >
# your project > Settings. SANITY_API_TOKEN needs at least Editor
# permissions (create/update documents) since scripts/seed-sanity-posts.mjs
# writes posts via the API. Never prefix the token with NEXT_PUBLIC_ — it's
# a secret and must stay server-side only, unlike the project ID/dataset.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_TOKEN=
# If unset, /blog renders with zero posts rather than failing to build.

# Resend — customer-facing confirmation emails on quote/contact/claim
# submission (distinct from GoTo's internal staff SMS notifications above).
# Get RESEND_API_KEY from resend.com/api-keys.
RESEND_API_KEY=
# RESEND_FROM_EMAIL: an address on a domain you've verified in Resend
# (SPF/DKIM — resend.com/domains). Until you set this, sends use Resend's
# shared onboarding@resend.dev sender, which only delivers to the email
# address on your Resend account, not real customers — fine for a first
# test, not for production. Format: "Elite Insurance Group <you@yourdomain.com>"
RESEND_FROM_EMAIL=
# If RESEND_API_KEY is unset, confirmation emails no-op automatically.

# Supabase Auth + Realtime — sales-team logins and live chat for the
# Scripted Lead Warmer (see docs/backlog.md). Separate from DATABASE_URL/
# DIRECT_URL above, which are the raw Postgres connection strings; these
# are Supabase's project API URL/keys, from the Supabase dashboard >
# Project Settings > API.
#
# NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are safe to
# expose client-side (the customer chat widget and staff dashboard both use
# them directly to open a Realtime connection / manage the staff session).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY is a secret — server-only. Used by
# scripts/seed-associates.mjs to create associate accounts via the Admin
# API, and by /api/staff/complete-setup to verify a session token
# server-side. Never prefix this one with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# If these are unset, the live-chat/dashboard features are disabled — the
# scripted chat still needs the base DATABASE_URL above to persist
# conversations, but claiming/takeover/staff login require Supabase Auth
# to be configured.

# Public site URL — used to build the redirect link in staff invite/reset
# emails (scripts/seed-associates.mjs). Must be a URL the *recipient's*
# browser can reach, not wherever you're running the script from: use your
# deployed URL (e.g. https://4k-elite-insurance.vercel.app) for real
# invites, localhost only when testing the flow yourself.
#
# IMPORTANT: this and the three Supabase vars above must ALSO be added to
# Vercel's project environment variables (not just .env.local) before a
# real invite sent to someone else will work — the same gotcha that broke
# /studio on first deploy (see docs/architecture.md).
NEXT_PUBLIC_SITE_URL=

# Cron secret — authenticates Vercel Cron's calls to
# /api/cron/sweep-conversations (see vercel.json). Generate any random
# string (e.g. `openssl rand -hex 32`) and set it here AND in Vercel's
# project environment variables; Vercel then automatically adds it as a
# `Bearer` Authorization header on its own scheduled invocations of that
# route, so nothing else needs to be configured for it to work in
# production. Without it, the cron route always returns 401 and no
# conversation is ever automatically marked abandoned. Worth confirming your
# Vercel plan's cron frequency limits support the 15-minute schedule in
# vercel.json before relying on it.
CRON_SECRET=

# Anthropic — internal Agent Brief generation (server-only, used by
# src/lib/ai/gateway.ts). Never NEXT_PUBLIC_ — this key must never reach the
# browser. If unset, briefs fall back to the deterministic builder in
# src/lib/ai/agentBrief/fallback.ts and nothing is ever sent to the model.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-5.
AI_MODEL=

# Agent Brief internal email -- default off. The staff SMS (4 lines, via
# GoTo above) always fires regardless of this setting; set to exactly
# "true" to also email the full brief to agency.email (lib/config/agency.ts)
# via Resend. See src/lib/notifications/leadNotify.ts's notifyAgentBrief.
AGENT_BRIEF_EMAIL=

# Rate-limit salt — used to hash (not store) the client IP on every new
# Quick Quote Chat conversation (/api/scripted-chat/start), so the app can
# reject a burst of conversations from the same source (more than 10/hour)
# without ever persisting a real IP address. Generate any random string
# (e.g. `openssl rand -hex 32`) once and keep it stable — rotating it resets
# the rate limit for everyone, since past hashes no longer match. If unset,
# rate limiting on /start silently no-ops (every conversation is allowed).
RATE_LIMIT_SALT=
